# Copie este arquivo para `.env` (na raiz do projeto) e preencha só as chaves que quiser usar.
# O `.env` fica fora do Git. Nunca cole chaves em mensagens, issues ou prints.
# Variáveis já definidas no ambiente têm prioridade sobre este arquivo.

# ---- Online gratuitos, com chave (sem cartão de crédito) ----
# Google AI Studio (Gemini): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
# Cerebras: https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Mistral (plano Experiment): https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# GitHub Models (token pessoal com permissão "models"): https://github.com/settings/tokens
GITHUB_API_KEY=
# Hugging Face (token de leitura): https://huggingface.co/settings/tokens
HF_TOKEN=
# Cloudflare Workers AI: token em https://dash.cloudflare.com/profile/api-tokens
# e o Account ID aparece na página inicial do painel da Cloudflare. As duas são obrigatórias.
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
# Cohere (chave Trial, só uso não comercial): https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# ---- Pagos (só são usados com a opção "Pagos" ligada) ----
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
